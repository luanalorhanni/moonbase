# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

# ----------------------------------------------------------------------------
# Supabase (https://supabase.com/dashboard)
# ----------------------------------------------------------------------------

# Project URL — public, safe to expose to the client.
# Found in: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key — public, used by the Supabase JS client in RSC and
# client components. RLS keeps reads/writes scoped to auth.uid().
# Found in: Project Settings → API → "Publishable key"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key — SECRET. Bypasses RLS. Only ever used in server-only code
# (cron handlers, scripts/migrate-from-spreadsheet.ts). Never reference from
# client components or files marked "use client".
# Found in: Project Settings → API → "Service role key" (legacy JWT) or the
# new "sb_secret_*" key.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# Drizzle / Postgres
# ----------------------------------------------------------------------------

# Postgres connection string used by Drizzle for queries and migrations.
# Found in: Project Settings → Database → Connection string.
#
# For local dev / migrations a "Direct connection" (port 5432) is fine.
# In production on Vercel, prefer the "Transaction pooler" (port 6543) for
# runtime queries to avoid connection exhaustion in serverless. Splitting
# DATABASE_URL into runtime vs migrate URLs is a phase 1 concern.
DATABASE_URL=
