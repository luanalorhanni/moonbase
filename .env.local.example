# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

# ----------------------------------------------------------------------------
# Drizzle / Postgres (Supabase)
# ----------------------------------------------------------------------------

# Postgres connection string used by Drizzle for queries and migrations.
# Found in: Supabase → Project Settings → Database → Connection string.
#
# Local dev: use the "Direct connection" (port 5432, host db.<ref>...). It
# supports DDL transactions, which drizzle-kit needs for migrations.
#
# Production (Vercel): use the "Transaction pooler" (port 6543, host
# aws-...pooler.supabase.com) for runtime. Migrations still run from the
# direct URL, typically from your laptop.
DATABASE_URL=

# ----------------------------------------------------------------------------
# Single-user identity
# ----------------------------------------------------------------------------

# Hardcoded user_id used by every query and insert. Set this to the UUID of
# your existing row in Supabase auth.users so previously seeded data stays
# visible. Find it in Supabase → Authentication → Users → click your user.
MOONBASE_USER_ID=

# ----------------------------------------------------------------------------
# Cron
# ----------------------------------------------------------------------------

# Shared secret between Vercel Cron and the /api/cron/monthly-snapshot
# handler. Vercel populates this automatically when the cron is configured
# via vercel.json; for local testing, generate any random string and pass
# it in the Authorization: Bearer <value> header.
CRON_SECRET=

# ----------------------------------------------------------------------------
# Unsplash (home cover image picker)
# ----------------------------------------------------------------------------

# Unsplash API access key — used server-side only by
# app/api/unsplash/search/route.ts to power the home cover picker.
# Get yours at https://unsplash.com/developers (create a demo app, then
# copy the Access Key — NOT the Secret Key, which we don't need).
UNSPLASH_ACCESS_KEY=

# ----------------------------------------------------------------------------
# Google Calendar (routines integration)
# ----------------------------------------------------------------------------

# OAuth 2.0 Web client credentials. Create at:
#   https://console.cloud.google.com/apis/credentials
# After enabling the Google Calendar API and configuring the OAuth
# consent screen. Add your local + prod callback URLs to the client's
# "Authorized redirect URIs":
#   http://localhost:3000/api/google-calendar/callback
#   https://<your-prod-domain>/api/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional override — defaults to http://localhost:3000/api/google-calendar/callback
GOOGLE_REDIRECT_URI=
