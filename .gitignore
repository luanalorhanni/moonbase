# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local state (per-machine, not tracked)
/.claude/

# Personal financial data (Excel exports, raw imports, scratch CSVs).
# The phase 8 migration script reads these from a configurable path.
*.xlsx
*.xls
*.csv


# OAuth client secrets and service-account keys (never commit)
client_secret*.json
*.apps.googleusercontent.com.json
*service-account*.json
*credentials*.json
*.p12
*.key

# Local-only maintenance scripts that read production data
/scripts/local/
